
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>EBookStore - Online Book Store</title>
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.3.0/font/bootstrap-icons.css">
    <style>
        body { 
            padding-bottom: 120px; 
         }

        footer.fixed-bottom {
            height: 50px; 
        }
    </style>

</head>
<body>
    <nav class="navbar navbar-expand-lg bg-primary navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">EBookStore</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01"
                    aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarColor01">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" href="/Home/Index">Home</a>
                    </li>
                  
                    <li class="nav-item">
                        <a class="nav-link" href="/AdminOperations/AllOrders">Orders</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Book/Index">Books</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Cart/GetUserCart">Cart</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Genre/Index">Genre</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Reports/TopFiveSellingBooks">Top Selling Books</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Stock/Index">Stock</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/UserOrder/UserOrders">User Order</a>
                    </li>
                </ul>

           
                <a href="/Cart/GetUserCart" class="btn btn-outline-light position-relative me-3"> 
                    🛒 Cart
                    <span id="cartCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        0
                    </span>
               </a>

                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

   
    <footer class="bg-primary text-white text-center py-3 fixed-bottom">
        <div class="container">
            &copy; @DateTime.Now.Year - EBookStore. All rights reserved.
        </div>
    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        async function loadCartCount() {
            try {
                const response = await fetch(`/cart/GetTotalItemInCart`);
                if (response.ok) {
                    const count = await response.json();
                    const cartCountEl = document.getElementById("cartCount");
                    if (cartCountEl) {
                        cartCountEl.innerText = count;
                    }
                }
            } catch (err) {
                console.error("Error loading cart count:", err);
            }
        }

        loadCartCount();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
