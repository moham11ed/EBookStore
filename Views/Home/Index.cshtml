

@model BookDisplayModel

<div class="px-4">
    <div class="my-2">
        <form asp-action="Index" class="row row-cols-lg-auto g-3 align-items-center">
            <div class="col-12">
                <label class="visually-hidden" for="genreId">Genres</label>
                <select class="form-select" id="genreId" name="genreId">
                    <option value="">Genre</option>
                    @foreach (var genre in Model.Genres)
                    {
                        <option selected="@(genre.Id == Model.GenreId)" value="@genre.Id">@genre.GenreName</option>
                    }
                </select>
            </div>

            <div class="col-12">
                <label class="visually-hidden" for="sterm">Search By Title</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" value="@(Model.STerm ?? "")"
                           id="sterm" name="sterm" placeholder="Search by title" />

                </div>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary">Search</button>
                <a href="/Home/Index" class="btn btn-secondary">Reset</a>
            </div>
        </form>
    </div>

    <div class="w-100 mt-4">
        <p><b>Books Count:</b> @Model.Books.Count()</p>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var book in Model.Books)
            {
       
                <div class="col mb-4">
                    <div class="card h-100 shadow rounded-4 border-0" style="transition: transform 0.3s;">
                        <div class="overflow-hidden rounded-top" style="height: 340px;">
                            <img src="/images/@(string.IsNullOrEmpty(book.Image) ? "no-image.jpg" : book.Image)"
                                 class="card-img-top"
                                 style="height: 100%; width: 100%; object-fit: cover;"
                                 alt="Book image" />
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="card-title text-primary fw-bold fs-4">@book.BookName</h5>
                            <p class="card-text text-muted flex-grow-1 fs-5">
                                <b>Genre:</b> @book.GenreName<br />
                                <b>Author:</b> @book.AuthorName<br />
                                <b>Price:</b> <span class="text-success">@book.Price EGP</span>
                            </p>
                            <button type="button" onclick="add(@book.Id)" class="btn btn-outline-primary mt-auto fs-6 py-2">
                                <i class="bi bi-cart-plus-fill me-1"></i> Add to Cart
                            </button>
                        </div>
                    </div>
                </div>

            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function add(bookId) {
            try {
                const response = await fetch('/cart/AddItem', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ bookId: bookId, qty: 1 })
                });

                if (response.ok) {
                    const count = await response.json();
                    const cartCountEl = document.getElementById("cartCount");
                    if (cartCountEl) cartCountEl.innerText = count;
                } else {
                    alert("Error adding to cart");
                }
            } catch (err) {
                console.error(err);
            }
        }
    </script>
}
