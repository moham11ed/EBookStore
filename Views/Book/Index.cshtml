@model IEnumerable<Book>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">📚 Book List</h2>
        <a asp-action="AddBook" asp-controller="Book" class="btn btn-primary"> Add New Book</a>
    </div>

    @if (Model?.Any() == true)
    {
        <div class="card shadow rounded-4">
            <div class="card-body p-0">
                <table class="table table-hover table-bordered align-middle mb-0">
                    <thead class="table-dark">
                        <tr class="text-center">
                            <th style="width: 100px;">Image</th>
                            <th>Book</th>
                            <th>Author</th>
                            <th>Genre</th>
                            <th>Price</th>
                            <th style="width: 160px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model)
                        {
                            <tr class="text-center">
                                <td>
                                    <img src="@(string.IsNullOrWhiteSpace(book.Image) ? "/Images/NoImage.png" : $"/images/{book.Image}")"
                                         alt="book image"
                                         class="img-thumbnail"
                                         style="width: 80px; height: 100px; object-fit: cover;" />
                                </td>
                                <td>@book.BookName</td>
                                <td>@book.AuthorName</td>
                                <td>@book.Genre?.GenreName</td>
                                <td>$@book.Price</td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="UpdateBook" asp-controller="Book" asp-route-id="@book.Id" class="btn btn-sm btn-success">
                                             Edit
                                        </a>
                                        <a asp-action="DeleteBook" asp-controller="Book" asp-route-id="@book.Id" class="btn btn-sm btn-danger"
                                           onclick="return confirm('Are you sure you want to delete this book?')">
                                             Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info mt-4">
            <h5 class="mb-0">No books found.</h5>
        </div>
    }
</div>
