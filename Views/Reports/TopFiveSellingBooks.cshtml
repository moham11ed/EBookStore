@using BookShoppingCartMvcUI.Models.DTOs
@model TopNSoldBooksVm

<div class="container mt-4">
    <h3 class="mb-4 text-primary">📈 Top Selling Books</h3>

    @if (Model != null)
    {
        <form asp-action="TopFiveSellingBooks" method="get" class="row g-2 align-items-center mb-4" style="max-width: 600px;">
            <div class="col-auto">
                <label for="sDate" class="col-form-label fw-semibold">Start Date:</label>
            </div>
            <div class="col-auto">
                <input type="date" id="sDate" name="sDate" class="form-control" style="min-width: 180px;" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-auto">
                <label for="eDate" class="col-form-label fw-semibold">End Date:</label>
            </div>
            <div class="col-auto">
                <input type="date" id="eDate" name="eDate" class="form-control" style="min-width: 180px;" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a href="/Reports/TopFiveSellingBooks" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>

        <h5 class="mb-3 text-muted">
            Showing results from
            <span class="fw-semibold">@Model.StartDate.ToString("dd-MMM-yyyy")</span>
            to
            <span class="fw-semibold">@Model.EndDate.ToString("dd-MMM-yyyy")</span>
        </h5>

        @if (!Model.TopNSoldBooks.Any())
        {
            <div class="alert alert-warning" role="alert" style="max-width: 600px;">
                No records found.
            </div>
        }
        else
        {
            <div class="table-responsive" style="max-width: 600px;">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Book</th>
                            <th>Sold Units</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.TopNSoldBooks)
                        {
                            <tr>
                                <td>@item.BookName by @item.AuthorName</td>
                                <td class="text-end">@item.TotalUnitSold</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else
    {
        <div class="alert alert-danger" style="max-width: 600px;">
            <h4>Something went wrong.</h4>
        </div>
    }
</div>
