@model GenreDTO
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5" style="max-width: 500px;">
    <div class="card shadow rounded-4">
        <div class="card-header bg-warning text-dark rounded-top-4">
            <h3 class="mb-0">✏️ Update Genre</h3>
        </div>

        <div class="card-body bg-light rounded-bottom-4">
            <a asp-action="Index" asp-controller="Genre" class="btn btn-secondary mb-3">← Back to List</a>

            
            @if (!ViewData.ModelState.IsValid)
            {
                    <div class="alert alert-danger">
                        Please fix the errors below and try again.
                    </div>
            }

            <form asp-action="UpdateGenre" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="form-group mb-3">
                    <label asp-for="GenreName" class="form-label fw-semibold">Genre Name *</label>
                    <input type="text" class="form-control" asp-for="GenreName" placeholder="Enter new genre name" />
                    <span asp-validation-for="GenreName" class="text-danger"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-warning btn-lg text-dark">
                        💾 Update Genre
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
